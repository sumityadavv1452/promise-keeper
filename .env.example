# ==============================================================================
# Promise Keeper - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Bee Wearable AI Configuration
# ------------------------------------------------------------------------------
# When BEE_MOCK_MODE is true or when the Bee hardware/CLI is unauthenticated/offline,
# Promise Keeper automatically loads rich multi-speaker conversation fixtures.
BEE_MOCK_MODE=true

# Path to Bee CLI executable (defaults to 'bee' in PATH if unset)
BEE_CLI_PATH=bee

# ------------------------------------------------------------------------------
# 2. Amazon Bedrock Configuration (AWS Builder Mini Challenge)
# ------------------------------------------------------------------------------
# Supported models: amazon.nova-pro-v1:0, anthropic.claude-3-5-sonnet-20241022-v2:0
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# AWS Credentials (leave blank if running with IAM instance profile or mock fallback)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Enable mock Bedrock fallback when AWS credentials are not configured
# Allows offline automated test suites and judging environments to succeed without AWS billing
BEDROCK_MOCK_FALLBACK=true

# ------------------------------------------------------------------------------
# 3. Action Router Integrations (Human-In-The-Loop Staging)
# ------------------------------------------------------------------------------
# Todoist Personal API Token (Optional: if blank, stages in simulated mode)
TODOIST_API_TOKEN=

# Google OAuth Credentials for Gmail Drafts and Google Calendar Tentative Blocks
# Path to OAuth 2.0 client secrets JSON (downloaded from Google Cloud Console)
GOOGLE_CREDENTIALS_FILE=credentials.json
# Path to saved user OAuth token (generated after first consent flow)
GOOGLE_TOKEN_FILE=token.json

# Default staging calendar ID ('primary' is the user's default calendar)
GOOGLE_CALENDAR_ID=primary
